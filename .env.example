# Base de datos (autenticacion de Windows)
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=MiCubiculoDB
DB_DRIVER=ODBC Driver 17 for SQL Server

# Clave para firmar sesiones y codigos de verificacion
SECRET_KEY=

# Cuenta de correo que envia los codigos. Estos tres valores son privados:
# solo van en el .env de quien administra el sistema.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 1 = imprime los codigos en la terminal en vez de enviarlos (solo desarrollo).  
CODIGOS_EN_CONSOLA=0